# Groq API key - get a free one at https://console.groq.com/keys (no credit card required)
GROQ_API_KEY=

# Optional: override the default model (see https://console.groq.com/docs/models
# for the current free-tier catalog, which changes over time)
# Fast, good default: openai/gpt-oss-20b
# Higher quality, slower/lower free-tier throughput: openai/gpt-oss-120b
GROQ_MODEL=openai/gpt-oss-20b

# Comma-separated list of origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:3000

# Max chat messages allowed per IP per hour
RATE_LIMIT_PER_HOUR=20
